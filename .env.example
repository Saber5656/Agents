# Set these paths locally in .env; do not commit personal values.
AGENTS_ROOT=
SKILLS_ROOT=
AGENTS_VAULT_ROOT=

# Optional daily news runner settings (machine-local news.local.env).
IT_NEWS_RUNTIME_ROOT=
IT_NEWS_ARCHIVE_ROOT=
CODEX_BIN=

# Optional scheduled job working root (machine-local schedule.local.env).
SCHEDULED_ROOT=

# Full daily batch: publication and Hermes notification destinations.
USER_VAULT_ROOT=
USER_VAULT_REMOTE=
AGENTS_VAULT_REMOTE=
NEWS_PUBLICATION_BRANCH=
PUBLISHER_GIT_NAME=
PUBLISHER_GIT_EMAIL=
GITLEAKS_BIN=
HERMES_BRIDGE_PYTHON=
# Optional override: uncomment in news.local.env for Slack or Discord.
# Omit NEWS_TARGET entirely to retain DISCORD_NEWS_TARGET compatibility.
# NEWS_TARGET=
# SLACK_BOT_TOKEN=
DISCORD_NEWS_TARGET=
