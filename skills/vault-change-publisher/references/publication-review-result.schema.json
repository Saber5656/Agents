{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "publication_context_sha256",
    "agents_vault",
    "user_vault",
    "next_action"
  ],
  "properties": {
    "outcome": {"enum": ["approved", "blocked"]},
    "publication_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "agents_vault": {"$ref": "#/$defs/taskChangeManifest"},
    "user_vault": {"$ref": "#/$defs/taskChangeManifest"},
    "next_action": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "blocked"}}},
      "then": {"properties": {"next_action": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {
        "required": ["agents_vault", "user_vault", "next_action"],
        "properties": {
          "agents_vault": {
            "required": ["publication_mode"],
            "properties": {
              "publication_mode": {"enum": ["sweep", "own_only"]}
            }
          },
          "user_vault": {
            "required": ["publication_mode"],
            "properties": {
              "publication_mode": {"enum": ["sweep", "own_only"]}
            }
          }
        }
      },
      "then": {"properties": {"next_action": {"type": "null"}}},
      "else": {
        "properties": {
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "artifactReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source_sha256", "target_path"],
      "properties": {
        "role": {"enum": ["user_it_news_summary", "agents_security_advisory"]},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_path": {"type": "string", "minLength": 1}
      }
    },
    "commitGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "paths"],
      "properties": {
        "message": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "deferredPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "existingCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "parents", "tree", "message", "changed_paths", "patch_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parents": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "message": {"type": "string"},
        "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "patch_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dirtyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_oid", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git_blob_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "mode": {"enum": ["100644", "100755", null]}
      }
    },
    "validationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_guard",
        "secret_scan",
        "secret_scan_tool",
        "secret_scan_tool_version",
        "reviewed_snapshot_sha256",
        "reviewed_history_sha256"
      ],
      "properties": {
        "file_guard": {"enum": ["passed", "blocked"]},
        "secret_scan": {"enum": ["passed", "blocked"]},
        "secret_scan_tool": {"const": "gitleaks"},
        "secret_scan_tool_version": {"type": "string", "minLength": 1},
        "reviewed_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewed_history_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidenceFinalization": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_path", "template"],
          "properties": {
            "target_path": {"type": "string", "minLength": 1},
            "template": {"const": "daily_publication_v1"}
          }
        }
      ]
    },
    "taskChangeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_root",
        "task_id",
        "publication_mode",
        "core_review_status",
        "residual_review_status",
        "owned_paths",
        "excluded_paths",
        "deferred_cleanup",
        "approved_diff_snapshot_sha256",
        "approved_existing_commits",
        "approved_dirty_entries",
        "reviewed_artifacts",
        "validation_evidence",
        "review_or_validation_status",
        "commit_required",
        "unrelated_dirty_paths",
        "commit_groups",
        "evidence_finalization"
      ],
      "properties": {
        "repo_root": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "publication_mode": {"enum": ["sweep", "own_only", "blocked"]},
        "core_review_status": {"enum": ["quality_ok", "blocked"]},
        "residual_review_status": {"enum": ["quality_ok", "deferred", "blocked"]},
        "owned_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excluded_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "deferred_cleanup": {"type": "array", "items": {"$ref": "#/$defs/deferredPath"}},
        "approved_diff_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_existing_commits": {"type": "array", "items": {"$ref": "#/$defs/existingCommit"}},
        "approved_dirty_entries": {"type": "array", "items": {"$ref": "#/$defs/dirtyEntry"}},
        "reviewed_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactReview"}},
        "validation_evidence": {"$ref": "#/$defs/validationEvidence"},
        "review_or_validation_status": {"enum": ["quality_ok", "blocked"]},
        "commit_required": {"type": "boolean"},
        "unrelated_dirty_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "commit_groups": {"type": "array", "items": {"$ref": "#/$defs/commitGroup"}},
        "evidence_finalization": {"$ref": "#/$defs/evidenceFinalization"}
      },
      "allOf": [
        {
          "if": {
            "required": ["core_review_status"],
            "properties": {"core_review_status": {"const": "quality_ok"}}
          },
          "then": {
            "properties": {"review_or_validation_status": {"const": "quality_ok"}}
          }
        },
        {
          "if": {
            "required": ["core_review_status"],
            "properties": {"core_review_status": {"const": "blocked"}}
          },
          "then": {
            "properties": {"review_or_validation_status": {"const": "blocked"}}
          }
        },
        {
          "if": {
            "required": ["publication_mode"],
            "properties": {"publication_mode": {"const": "blocked"}}
          },
          "then": {
            "properties": {
              "owned_paths": {"minItems": 1},
              "approved_dirty_entries": {"maxItems": 0},
              "reviewed_artifacts": {"minItems": 1},
              "residual_review_status": {"enum": ["deferred", "blocked"]},
              "commit_required": {"const": false},
              "commit_groups": {"maxItems": 0},
              "evidence_finalization": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
